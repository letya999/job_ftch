# === Telegram ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=job_ftch_prod

# === LLM ===
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_ENABLED=true

# === Store ===
STORE_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/job_ftch

# === Pipeline ===
PIPELINE_MAX_ITEMS_PER_RUN=500
PIPELINE_DEDUP_THRESHOLD=88

# === Output ===
OUTPUT_JSON_PATH=/data/jobs.json

# === Telegram Publisher ===
TG_BOT_TOKEN=
TG_CHANNEL_ID=

# === Observability ===
LOG_LEVEL=INFO
OTEL_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
