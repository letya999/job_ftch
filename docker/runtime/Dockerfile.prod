FROM python:3.12-slim@sha256:e5c9fa26ffb76e11e0f054f30dc2523a2f9693f0c36c0cf1e39b27e152d899fc

RUN groupadd -r appuser && useradd -r -g appuser -d /opt/job-ftch-home appuser

WORKDIR /app

ENV HOME=/opt/job-ftch-home \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

# Runtime image for the library layer only: pipeline, stores, embeddings,
# scrapers, Playwright, and CloakBrowser. Adapter-specific deps stay out.
# Keep the runtime user and realistic font surface in prod, but do not
# restore the unused BGE-M3 preload layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg ca-certificates xvfb xauth \
    && rm -rf /var/lib/apt/lists/*
RUN sed -i 's/^Components: main$/Components: main contrib/' \
        /etc/apt/sources.list.d/debian.sources \
    && echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" \
        | debconf-set-selections \
    && apt-get update && apt-get install -y --no-install-recommends \
        fontconfig fonts-dejavu fonts-dejavu-core fonts-dejavu-extra \
        fonts-liberation fonts-liberation2 \
        fonts-noto-core fonts-noto fonts-noto-cjk fonts-noto-color-emoji \
        fonts-roboto fonts-open-sans \
        ttf-mscorefonts-installer \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/job-ftch-home /opt/playwright && chown appuser:appuser /opt/job-ftch-home /opt/playwright

# Dependency metadata only, with a placehnewer package so the wheel can build. The verify
# script is copied after the installs on purpose: copying it here tied the ~1.1 GB install
# layer to that file, so editing it re-downloaded torch and CUDA.
COPY --chown=appuser:appuser pyproject.toml README.md LICENSE uv.lock ./
RUN mkdir -p job_ftch scripts && touch job_ftch/__init__.py

RUN /usr/local/bin/python -m pip install --no-cache-dir "uv==0.9.26" \
    && uv sync --locked --no-dev --all-extras
ENV PATH="/app/.venv/bin:$PATH"
RUN patchright install --with-deps chromium
# Camoufox is Firefox-based and needs GTK, which the Chromium dep set does not provide.
# `camoufox fetch` only downloads the binary, so without this the tier imports fine and
# then dies at launch with "libgtk-3.so.0: cannot open shared object file".
RUN patchright install-deps firefox
RUN mkdir -p /opt/job-ftch-home/.cache/camoufox \
    && chown appuser:appuser /opt/job-ftch-home/.cache/camoufox
RUN python -m camoufox fetch
RUN python -m cloakbrowser install

COPY --chown=appuser:appuser . /app
RUN mkdir -p /app/.runtime /app/artifacts \
    && chown appuser:appuser /app/.runtime /app/artifacts

COPY scripts/verify_browser_runtime.py ./scripts/verify_browser_runtime.py

ENV PYTHONPATH=/app
USER appuser

RUN python scripts/verify_browser_runtime.py
