# Copy to docker/local-mcp/.env before `docker compose up`.
# CLIProxyAPI must run on the host with Codex OAuth completed.

# OpenAI-compatible gateway = CLIProxyAPI (Codex subscription for LLM steps only)
JOB_FTCH_OPENAI_BASE_URL=http://host.docker.internal:8317/v1
# Must match the client API key configured in CLIProxyAPI
JOB_FTCH_OPENAI_API_KEY=cliproxy-local-key
# Use ids listed by GET /v1/models on CLIProxyAPI (see docker/local-mcp/README.md).
# Both must resolve on the gateway: extract uses OPENAI_MODEL; the relevance
# judge uses RELEVANCE_LLM_MODEL (default gpt-4.1-mini is OpenAI-only and 400s on CLIProxy).
JOB_FTCH_OPENAI_MODEL=gpt-5.4-mini
JOB_FTCH_RELEVANCE_LLM_MODEL=gpt-5.4-mini
JOB_FTCH_OPENAI_TIMEOUT_SECONDS=120

# Forced off in compose; kept here for documentation
JOB_FTCH_TRACING_ENABLED=false
JOB_FTCH_OPENOBSERVE_ENABLED=false
