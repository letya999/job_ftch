{
  // Разметка markdown. Смысловые правила проверяет docs_scripts/docs_lint.py,
  // здесь только форматирование. Запуск через just lint-md.
  "config": {
    "default": true,

    // Ширина строки. Документация переносится вручную, чтобы диффы были
    // построчными и понятными на ревью.
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": true
    },

    // Разрешаем inline HTML: details, маркеры генерируемых блоков.
    "MD033": false,

    // Первая строка файла - frontmatter, а не заголовок.
    "MD041": false,

    // Поле title во frontmatter не считается заголовком документа: иначе
    // единственный H1 в теле выглядит как второй.
    "MD025": { "front_matter_title": "" },

    // Одинаковые заголовки в разных секциях допустимы: "Команды" встречается
    // в нескольких документах на одном уровне вложенности.
    "MD024": { "siblings_only": true },

    // Знаки препинания в заголовках нужны для вопросов вида "Что где лежит?".
    "MD026": { "punctuation": ".,;:!" },

    // Нумерованные списки со сплошной нумерацией.
    "MD029": { "style": "ordered" },

    // Голые URL запрещены: ссылка должна быть аннотирована.
    "MD034": true,

    // Выравнивание столбцов таблиц. Отключено: правило считает ширину в
    // символах, а таблицы на кириллице выравниваются по видимой ширине.
    // Автоисправления у правила нет, ручная подгонка ломается при первой правке.
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".site/**", ".venv/**"]
}
