# ==========================================
# Core Pipeline Configuration
# ==========================================
# JOB_FTCH_SOURCE_BACKEND: Defines where jobs are fetched from. (Options: local_fixture, telegram_channel, telegram_group, telegram_comments, career_site)
JOB_FTCH_SOURCE_BACKEND=local_fixture

# JOB_FTCH_SINK_BACKEND: Defines where processed jobs are sent. (Options: json_file, telegram_posting, none)
JOB_FTCH_SINK_BACKEND=json_file

# JOB_FTCH_STORE_BACKEND: The default Docker runtime uses Postgres.
JOB_FTCH_STORE_BACKEND=postgres
JOB_FTCH_STORE_DSN=postgresql://job_user:job_password@localhost:5432/job_ftch

# JOB_FTCH_LOG_LEVEL: Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL).
JOB_FTCH_LOG_LEVEL=DEBUG

# JOB_FTCH_PIPELINE_MAX_ITEMS_PER_RUN: Global limit for jobs processed in one run to avoid overloading.
JOB_FTCH_PIPELINE_MAX_ITEMS_PER_RUN=200

# JOB_FTCH_PIPELINE_MAX_TEXT_LENGTH: Truncates overly long job descriptions.
JOB_FTCH_PIPELINE_MAX_TEXT_LENGTH=20000

# ==========================================
# Telemetry and Metrics
# ==========================================
JOB_FTCH_TELEMETRY_SERVICE_NAME=job_ftch
JOB_FTCH_TELEMETRY_CONSOLE_EXPORTER=false

# ==========================================
# LLM and Processing Options
# ==========================================
# JOB_FTCH_LLM_BACKEND: The Docker bot runtime uses OpenAI for extraction.
JOB_FTCH_LLM_BACKEND=openai

# JOB_FTCH_POSTING_BACKEND: Destination backend for publishing. (Options: none, telegram_posting)
JOB_FTCH_POSTING_BACKEND=none

# ==========================================
# File Paths and Storage
# ==========================================
# Input paths for debug mode
JOB_FTCH_DEBUG_SOURCE_PATH=fixtures/debug/raw_items.json

# Output path settings
JOB_FTCH_OUTPUT_PATH=artifacts/debug/raw_items.json
JOB_FTCH_OUTPUT_JSONL=false
JOB_FTCH_OUTPUT_SCHEMA_VERSION=job_ftch.job.v1

# Quarantine outputs (failed validation but not rejected)
JOB_FTCH_QUARANTINE_OUTPUT_PATH=artifacts/debug/quarantine.jsonl
JOB_FTCH_QUARANTINE_OUTPUT_JSONL=true
JOB_FTCH_QUARANTINE_OUTPUT_SCHEMA_VERSION=job_ftch.quarantine.v1

# Review outputs (need manual review)
JOB_FTCH_REVIEW_OUTPUT_PATH=artifacts/debug/review.jsonl
JOB_FTCH_REVIEW_OUTPUT_JSONL=true
JOB_FTCH_REVIEW_OUTPUT_SCHEMA_VERSION=job_ftch.job.v1

# Rejected outputs (spam, irrelevant)
JOB_FTCH_REJECTED_OUTPUT_PATH=artifacts/debug/rejected.jsonl
JOB_FTCH_REJECTED_OUTPUT_JSONL=true
JOB_FTCH_REJECTED_OUTPUT_SCHEMA_VERSION=job_ftch.rejected.v1

# ==========================================
# Quality and Routing Thresholds
# ==========================================
JOB_FTCH_REVIEW_MAX_QUALITY_SCORE=0.65
JOB_FTCH_POSTING_MIN_QUALITY_SCORE=0.8

# ==========================================
# Telegram Integration (Optional)
# ==========================================
# Core credentials for reading/posting to Telegram
JOB_FTCH_TELEGRAM_API_ID=12345678
JOB_FTCH_TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
JOB_FTCH_TELEGRAM_SESSION_PATH=.runtime/telegram-dev.session
JOB_FTCH_TELEGRAM_ENTITY=my_target_channel
JOB_FTCH_TELEGRAM_PUBLISH_ENTITY=my_output_channel

# Telegram rate limits and thresholds
JOB_FTCH_TELEGRAM_MESSAGE_LIMIT=100
JOB_FTCH_TELEGRAM_COMMENT_POST_LIMIT=20
JOB_FTCH_TELEGRAM_COMMENT_LIMIT_PER_POST=50
JOB_FTCH_TELEGRAM_JITTER_MIN_SECONDS=1.0
JOB_FTCH_TELEGRAM_JITTER_MAX_SECONDS=4.0
JOB_FTCH_TELEGRAM_FLOOD_SLEEP_THRESHOLD_SECONDS=60

# Telegram Proxy (Optional)
# JOB_FTCH_TELEGRAM_PROXY_TYPE can be socks5, socks4, http, mtproxy
JOB_FTCH_TELEGRAM_PROXY_TYPE=socks5
JOB_FTCH_TELEGRAM_PROXY_HOST=127.0.0.1
JOB_FTCH_TELEGRAM_PROXY_PORT=1080
JOB_FTCH_TELEGRAM_PROXY_USERNAME=my_proxy_user
JOB_FTCH_TELEGRAM_PROXY_PASSWORD=my_proxy_pass

# Telegram network timeouts and retries
JOB_FTCH_TELEGRAM_TIMEOUT_SECONDS=10.0
JOB_FTCH_TELEGRAM_REQUEST_RETRIES=3
JOB_FTCH_TELEGRAM_CONNECTION_RETRIES=3
JOB_FTCH_TELEGRAM_RETRY_DELAY_SECONDS=1.0

# ==========================================
# OpenAI Integration (Optional)
# ==========================================
JOB_FTCH_OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
JOB_FTCH_OPENAI_MODEL=gpt-4o-mini
JOB_FTCH_OPENAI_BASE_URL=https://api.openai.com/v1
JOB_FTCH_OPENAI_TIMEOUT_SECONDS=30.0
JOB_FTCH_OPENAI_MAX_RETRIES=2

# ==========================================
# Career Site and Monitoring Configuration
# ==========================================
# Base parameters for career_site backend

# Career Site HTTP client tuning
JOB_FTCH_CAREER_SITE_TIMEOUT_SECONDS=15.0
JOB_FTCH_CAREER_SITE_CONNECT_TIMEOUT_SECONDS=30.0
JOB_FTCH_CAREER_SITE_MAX_RETRIES=2
JOB_FTCH_CAREER_SITE_RETRY_DELAY_SECONDS=1.0
JOB_FTCH_CAREER_SITE_MAX_CONNECTIONS=10
JOB_FTCH_CAREER_SITE_MAX_KEEPALIVE_CONNECTIONS=5
JOB_FTCH_CAREER_SITE_DETAIL_CONCURRENCY=5

# Playwright Browser tuning (used by stealth monitors like DOM/NextData)
# DEFAULT: individual action timeout (e.g., page load). CONTEXT: max lifetime of a browser context.
JOB_FTCH_BROWSER_DEFAULT_TIMEOUT_MS=30000
JOB_FTCH_BROWSER_CONTEXT_TIMEOUT_MS=120000
JOB_FTCH_BROWSER_CHALLENGE_RETRIES=1

# Universal monitor API timeouts (Workday, Lever, SmartRecruiters, Deel)
JOB_FTCH_MONITOR_TIMEOUT_SECONDS=15.0
JOB_FTCH_MONITOR_MAX_RETRIES=3

# Timeouts for various independent fetchers
JOB_FTCH_RSS_TIMEOUT_SECONDS=30.0
JOB_FTCH_API_TIMEOUT_SECONDS=30.0
JOB_FTCH_OLLAMA_TIMEOUT_SECONDS=30.0
JOB_FTCH_FINGERPRINTER_TIMEOUT_SECONDS=8.0

# ==========================================
# Advanced Infrastructure (Vector DBs, Search)
# ==========================================
JOB_FTCH_JOB_BACKEND=postgres  # Options: sqlite, postgres
JOB_FTCH_SEARCH_BACKEND=hybrid  # Options: sqlite, postgres, hybrid
JOB_FTCH_JOB_STORE_PATH=.runtime/db/jobs.sqlite
JOB_FTCH_SEARCH_LANGUAGE=russian  # Options: simple, english, russian

JOB_FTCH_EMBEDDING_ENABLED=true
JOB_FTCH_EMBEDDING_PROVIDER=openai  # Options: openai, ollama
JOB_FTCH_EMBEDDING_MODEL=text-embedding-3-small
JOB_FTCH_EMBEDDING_DIMENSIONS=1536
JOB_FTCH_VECTOR_BACKEND=qdrant  # Options: qdrant, none

JOB_FTCH_QDRANT_URL=http://localhost:6333
JOB_FTCH_QDRANT_API_KEY=my-qdrant-secret-key
JOB_FTCH_QDRANT_COLLECTION=job_ftch_jobs
JOB_FTCH_OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# Telegram BOT adapter configuration lives in adapters/telegram_bot/.env.dev.
# ==========================================
