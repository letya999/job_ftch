# ==========================================
# Telegram BOT adapter - PROD environment (example)
# Copy to .env.prod and fill in real production values.
# ==========================================

# Consumed by docker-compose.prod.yml, not by the application. POSTGRES_PASSWORD has no
# default there, so compose refuses to start without it:
#   "required variable POSTGRES_PASSWORD is missing a value".
# USER and DB fall back to job_user/job_ftch; the password never does, by design.
POSTGRES_USER=job_user
# Password for the compose PostgreSQL. No default on purpose, so a stack cannot start on a guessable one.
POSTGRES_PASSWORD=
POSTGRES_DB=job_ftch

JOB_FTCH_CONFIGS_DIR=job_ftch/adapters/telegram_bot/config/tenants
JOB_FTCH_RUNTIME_CONFIG_PATH=config/runtime.yaml:config/runtime.prod.yaml:job_ftch/adapters/telegram_bot/runtime.prod.yaml
JOB_FTCH_SOURCE_BACKEND=telegram_channel
JOB_FTCH_STORE_BACKEND=postgres
JOB_FTCH_JOB_BACKEND=postgres
JOB_FTCH_JOB_GROUP_STORE_BACKEND=postgres
JOB_FTCH_SEARCH_BACKEND=hybrid
JOB_FTCH_VECTOR_BACKEND=qdrant
JOB_FTCH_TELEGRAM_API_ID=
JOB_FTCH_TELEGRAM_API_HASH=
JOB_FTCH_OPENAI_API_KEY=
JOB_FTCH_OPENOBSERVE_URL=http://host.docker.internal:5080
JOB_FTCH_OPENOBSERVE_ORG=default
JOB_FTCH_OPENOBSERVE_USERNAME=admin@job-ftch.local
JOB_FTCH_OPENOBSERVE_PASSWORD=

JOB_FTCH_AUTH_TELEGRAM_BOT_TOKEN=
JOB_FTCH_AUTH_TELEGRAM_BOT_ADMIN_USER_IDS=
JOB_FTCH_AUTH_TELEGRAM_BOT_ALLOWED_USER_IDS=
JOB_FTCH_AUTH_TELEGRAM_BOT_ALLOWED_CHAT_IDS=
JOB_FTCH_AUTH_TELEGRAM_BOT_RATE_LIMIT_SECONDS=2.0
JOB_FTCH_AUTH_TELEGRAM_BOT_DIGEST_SIZE=10

# Bot logs go to their own stream: the shared job_ftch_ingest stream also
# receives host-side eval/ingest scripts, which makes bot incidents hard to isolate.
JOB_FTCH_OPENOBSERVE_LOGS_STREAM=job_ftch_bot
