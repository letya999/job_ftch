# Telegram bot adapter env for local development.
# Keep only adapter wiring and auth in env.
# Non-secret bot runtime overrides live in:
#   job_ftch/adapters/telegram_bot/runtime.dev.yaml

JOB_FTCH_CONFIGS_DIR=job_ftch/adapters/telegram_bot/config/tenants
JOB_FTCH_RUNTIME_CONFIG_PATH=config/runtime.yaml:config/runtime.dev.yaml:job_ftch/adapters/telegram_bot/runtime.dev.yaml
JOB_FTCH_SOURCE_BACKEND=telegram_channel
JOB_FTCH_STORE_BACKEND=postgres
JOB_FTCH_JOB_BACKEND=postgres
JOB_FTCH_JOB_GROUP_STORE_BACKEND=postgres
JOB_FTCH_SEARCH_BACKEND=hybrid
JOB_FTCH_VECTOR_BACKEND=qdrant
# Telegram MTProto app id from my.telegram.org. Needed to read channels/groups.
JOB_FTCH_TELEGRAM_API_ID=
# Telegram MTProto app hash from my.telegram.org (32 hex chars). Pairs with API_ID.
JOB_FTCH_TELEGRAM_API_HASH=
# OpenAI key used for extraction, the relevance judge and embeddings.
JOB_FTCH_OPENAI_API_KEY=

# Bot token from BotFather. Anyone holding it controls the bot.
JOB_FTCH_AUTH_TELEGRAM_BOT_TOKEN=
JOB_FTCH_AUTH_TELEGRAM_BOT_ADMIN_USER_IDS=12345678
JOB_FTCH_AUTH_TELEGRAM_BOT_ALLOWED_USER_IDS=12345678
JOB_FTCH_AUTH_TELEGRAM_BOT_ALLOWED_CHAT_IDS=
JOB_FTCH_AUTH_TELEGRAM_BOT_RATE_LIMIT_SECONDS=1.0
JOB_FTCH_AUTH_TELEGRAM_BOT_DIGEST_SIZE=5

# OpenObserve is deployed separately under deploy/observability.
JOB_FTCH_OPENOBSERVE_URL=http://host.docker.internal:5080
JOB_FTCH_OPENOBSERVE_ORG=default
JOB_FTCH_OPENOBSERVE_USERNAME=admin@job-ftch.local
# OpenObserve password for operational logs and metrics.
JOB_FTCH_OPENOBSERVE_PASSWORD=

# Bot logs go to their own stream: the shared job_ftch_ingest stream also
# receives host-side eval/ingest scripts, which makes bot incidents hard to isolate.
JOB_FTCH_OPENOBSERVE_LOGS_STREAM=job_ftch_bot
