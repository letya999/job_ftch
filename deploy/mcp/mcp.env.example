JOB_FTCH_LLM_BACKEND=openai
JOB_FTCH_OPENAI_BASE_URL=http://127.0.0.1:8317/v1
JOB_FTCH_OPENAI_API_KEY=cliproxy-local-key
# Must appear in GET /v1/models (CLIProxy). Align both — relevance judge uses
# RELEVANCE_LLM_MODEL separately from OPENAI_MODEL.
JOB_FTCH_OPENAI_MODEL=gpt-5.4-mini
JOB_FTCH_RELEVANCE_LLM_MODEL=gpt-5.4-mini
JOB_FTCH_OPENAI_TIMEOUT_SECONDS=120
JOB_FTCH_TRACING_ENABLED=false
JOB_FTCH_OPENOBSERVE_ENABLED=false
JOB_FTCH_STORE_BACKEND=sqlite
JOB_FTCH_JOB_BACKEND=sqlite
JOB_FTCH_SEARCH_BACKEND=sqlite
JOB_FTCH_JOB_GROUP_STORE_BACKEND=sqlite
JOB_FTCH_CONFIGS_DIR=/etc/job_ftch/tenants
JOB_FTCH_STORE_PATH=/var/lib/job_ftch/{tenant_id}/store.db
