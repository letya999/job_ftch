          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT source_key, source_name, status, yielded, emitted, conversion_accept, quality_reliable, quality_rich, quality_high_relevance FROM \"__LOGS_STREAM__\" WHERE event = 'source_run_stats' AND source_run_id = '$source_run_id' AND (quality_important = true OR cast(quality_important as text) IN ('true', '1', 't', 'True')) ORDER BY emitted DESC, yielded DESC",
