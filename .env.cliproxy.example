# CLIProxyAPI profile (ADR 079). Copy to `.env.cliproxy` and fill the client
# key from the local CLIProxy config. Then either:
#   set JOB_FTCH_LLM_GATEWAY=cliproxy
#   or pass `--llm-gateway cliproxy` to scripts/eval/run_pipeline_eval.py
#
# Model names live in config/runtime.cliproxy.yaml and must match
# GET $JOB_FTCH_OPENAI_BASE_URL/models.

JOB_FTCH_LLM_GATEWAY=cliproxy
JOB_FTCH_LLM_BACKEND=openai
JOB_FTCH_OPENAI_BASE_URL=http://127.0.0.1:8317/v1
JOB_FTCH_OPENAI_API_KEY=cliproxy-local-key

# Image captcha OCR uses JOB_FTCH_OPENAI_API_KEY (same client key).
# Copy the two routing vars into `.env.dev` to keep pipeline LLM on OpenAI
# while OCR still hits local CLIProxy.
JOB_FTCH_CAPTCHA_VISION_BASE_URL=http://127.0.0.1:8317/v1
JOB_FTCH_CAPTCHA_VISION_MODEL=gemini-3-flash
