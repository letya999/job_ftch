# Root runtime env: copy this file to `.env` for a local single-file setup.
# For explicit environments prefer `.env.dev.example` or `.env.prod.example`.
# Never commit real secrets.
#
# Non-secret policy and tuning live in:
#   config/runtime.yaml
#   config/runtime.dev.yaml
#
# Override the runtime YAML location only when you need a custom path:
# JOB_FTCH_RUNTIME_CONFIG_PATH=config/runtime.yaml;config/runtime.dev.yaml

# Core wiring
JOB_FTCH_SOURCE_BACKEND=telegram_channel
JOB_FTCH_SINK_BACKEND=json_file
JOB_FTCH_STORE_BACKEND=postgres
JOB_FTCH_STORE_DSN=postgresql://job_user:CHANGE_ME@localhost:5432/job_ftch  # pragma: allowlist secret -- placeholder DSN, not a credential
JOB_FTCH_JOB_BACKEND=postgres
JOB_FTCH_SEARCH_BACKEND=hybrid
JOB_FTCH_JOB_GROUP_STORE_BACKEND=postgres
JOB_FTCH_VECTOR_BACKEND=qdrant
JOB_FTCH_LLM_BACKEND=heuristic
JOB_FTCH_POSTING_BACKEND=none
JOB_FTCH_LOG_LEVEL=INFO

# Local paths
JOB_FTCH_DEBUG_SOURCE_PATH=fixtures/debug/raw_items.json
JOB_FTCH_OUTPUT_PATH=artifacts/dev/telegram_durov.json
JOB_FTCH_QUARANTINE_OUTPUT_PATH=artifacts/debug/quarantine.jsonl
JOB_FTCH_REVIEW_OUTPUT_PATH=artifacts/debug/review.jsonl
JOB_FTCH_REJECTED_OUTPUT_PATH=artifacts/debug/rejected.jsonl

# Telegram reader / publisher
# Telegram MTProto app id from my.telegram.org. Needed to read channels/groups.
JOB_FTCH_TELEGRAM_API_ID=
# Telegram MTProto app hash from my.telegram.org (32 hex chars). Pairs with API_ID.
JOB_FTCH_TELEGRAM_API_HASH=
JOB_FTCH_TELEGRAM_SESSION_PATH=.runtime/telegram-dev.session
JOB_FTCH_TELEGRAM_ENTITY=durov
JOB_FTCH_TELEGRAM_PUBLISH_ENTITY=my_output_channel

# External services
# OpenAI key used for extraction, the relevance judge and embeddings.
JOB_FTCH_OPENAI_API_KEY=
JOB_FTCH_OPENAI_BASE_URL=https://api.openai.com/v1
JOB_FTCH_QDRANT_URL=http://localhost:6333
# Qdrant API key. Leave empty for a local instance without auth.
JOB_FTCH_QDRANT_API_KEY=

# Top-level feature switches
JOB_FTCH_EMBEDDING_ENABLED=false
JOB_FTCH_BGEM3_ENABLED=true
JOB_FTCH_RELEVANCE_BACKEND=shots

# Observability
JOB_FTCH_TELEMETRY_SERVICE_NAME=job_ftch
JOB_FTCH_TELEMETRY_CONSOLE_EXPORTER=false
JOB_FTCH_TRACING_ENABLED=false
JOB_FTCH_TRACING_CAPTURE_PAYLOADS=false
JOB_FTCH_LANGFUSE_HOST=http://localhost:3001
JOB_FTCH_LANGFUSE_PUBLIC_KEY=pk-lf-your-dev-project-public-key
# Langfuse secret key for LLM tracing. Optional; tracing is skipped when unset.
JOB_FTCH_LANGFUSE_SECRET_KEY=
JOB_FTCH_OPENOBSERVE_URL=http://host.docker.internal:5080
JOB_FTCH_OPENOBSERVE_ORG=default
JOB_FTCH_OPENOBSERVE_USERNAME=admin@job-ftch.local
# OpenObserve password for operational logs and metrics.
JOB_FTCH_OPENOBSERVE_PASSWORD=
