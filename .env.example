# job_ftch Environment Configuration
# Copy this file to .env and fill in your values.

# --- Core Runtime ---
# Options: memory, sqlite, postgres
JOB_FTCH_STORE_BACKEND=sqlite
# For sqlite: .runtime/job_ftch.db
JOB_FTCH_STORE_DSN=
# Options: sqlite, postgres
JOB_FTCH_JOB_BACKEND=sqlite
# For postgres: postgresql://user:pass@host:port/db
# JOB_FTCH_STORE_DSN=postgresql://user:pass@localhost:5432/job_ftch

# --- Logging & Debug ---
JOB_FTCH_LOG_LEVEL=INFO
# Path to tenant configs directory
JOB_FTCH_CONFIGS_DIR=config/tenants

# --- Telegram Source ---
# Get these from https://my.telegram.org
JOB_FTCH_TELEGRAM_API_ID=
JOB_FTCH_TELEGRAM_API_HASH=
# Session file path
JOB_FTCH_TELEGRAM_SESSION_PATH=.runtime/telegram.session

# --- LLM Extraction (OpenAI / Instructor) ---
JOB_FTCH_OPENAI_API_KEY=
JOB_FTCH_OPENAI_MODEL=gpt-4o-mini
# Optional: for local LLM proxies
# JOB_FTCH_OPENAI_BASE_URL=

# --- Vector Search (Optional) ---
# Options: qdrant, pgvector
JOB_FTCH_VECTOR_BACKEND=
JOB_FTCH_QDRANT_URL=
JOB_FTCH_QDRANT_API_KEY=
# Options: openai, fastembed
JOB_FTCH_EMBEDDING_PROVIDER=fastembed

# --- Observability ---
JOB_FTCH_METRICS_ENABLED=false
JOB_FTCH_METRICS_PORT=9090
