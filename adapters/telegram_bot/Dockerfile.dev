FROM python:3.12-slim
WORKDIR /app

# Install system dependencies needed by Playwright/Chromium and pip builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy only dependency manifest so this layer is cached between dep changes
COPY pyproject.toml README.md ./
# Create dummy package to satisfy hatchling during dependency install
RUN mkdir job_ftch && touch job_ftch/__init__.py
# Install all runtime extras needed by the bot
RUN pip install --no-cache-dir ".[bot,postgres,openai,qdrant,feeds,site_scrapers,embeddings,site_scrapers,stealth]"

# Install Playwright Chromium browser and its system dependencies.
RUN playwright install --with-deps chromium

# Source code is mounted via docker-compose volume — no COPY here.
# Any code change is live after `docker compose restart bot`.
ENV PYTHONPATH=/app \
    JOB_FTCH_CONFIGS_DIR=/app/adapters/telegram_bot/config/tenants
CMD ["job_ftch", "telegram-bot"] 
