# Bot configuration example
JOB_FTCH_BOT_TOKEN=123456789:ABCDEF...
JOB_FTCH_ADMIN_ID=12345678
JOB_FTCH_BOT_WEB_UI_URL=http://localhost:3000

# Pipeline settings
JOB_FTCH_BOT_SEND_LIMIT_PER_RUN=10
JOB_FTCH_BOT_MIN_QUALITY_SCORE=0.25
JOB_FTCH_EXTRACTION_MIN_SEARCH_RELEVANCE=0.25
JOB_FTCH_EMBEDDING_PREFILTER_MODEL=TechWolf/JobBERT-v3
JOB_FTCH_PIPELINE_MAX_LLM_CALLS_PER_RUN=30

# Tenant settings
JOB_FTCH_TENANT_ID=default
JOB_FTCH_TENANT_DISPLAY_NAME=Default
